{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "packageRules": [
        {
            "matchPackageNames": [
                "actions/*",
                "docker/*",
                "sigstore/*",
                "github/*"
            ],
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "Actions/Docker/SigStore actions",
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchPackageNames": [
                "mkaraki/mkarakiapps-releasing-actions"
            ],
            "matchManagers": [
                "github-actions"
            ],
            "versioning": "semver",
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchPackageNames": [
                "slim/*"
            ],
            "matchManagers": [
                "composer"
            ],
            "groupName": "Slim Framework",
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchPackageNames": [
                "sentry/sentry"
            ],
            "matchManagers": [
                "composer"
            ],
            "groupName": "Sentry",
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchPackageNames": [
                "pestphp/*",
                "vimeo/psalm",
                "cypress",
                "playwright"
            ],
            "groupName": "Testing frameworks",
            "automerge": true,
            "automergeType": "pr"
        }
    ],
    "bumpVersions": [
        {
            "name": "Application version",
            "filePatterns": [
                "app_info.php"
            ],
            "matchStrings": [
                "const APP_VERSION\\s*=\\s*['\"]v?(?<version>\\d+\\.\\d+\\.\\d+)['\"]"
            ],
            "bumpType": "patch"
        }
    ],
    "assignees": [
        "mkaraki"
    ]
}
